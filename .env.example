# =============================================================================
# HOTEL BOOKING SYSTEM (MVP) - ENVIRONMENT CONFIGURATION TEMPLATE
# Sao chép tệp này thành .env và điền các giá trị thực tế trước khi khởi chạy
#
# ⚠️ CẢNH BÁO BẢO MẬT QUAN TRỌNG:
# 1. Các giá trị trong tệp này CHỈ DÀNH CHO MÔI TRƯỜNG PHÁT TRIỂN / DEMO LOCAL.
# 2. KHÔNG ĐƯỢC SỬ DỤNG các giá trị bí mật này cho môi trường PRODUCTION / VPS.
# 3. Khi triển khai lên VPS, tạo chuỗi ngẫu nhiên mới cho JWT_SECRET và DB mật khẩu.
# 4. TUYỆT ĐỐI KHÔNG commit tệp .env thật lên kho mã nguồn GitHub!
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL)
# -----------------------------------------------------------------------------
MYSQL_DATABASE=hotel_db
MYSQL_USER=hotel_user
MYSQL_PASSWORD=hotel_password_secure
DB_ROOT_PASSWORD=root_password_secure
# Cổng expose ra ngoài Host (máy chủ) cho MySQL
DB_HOST_PORT=3306

# Chuỗi kết nối JDBC cho Spring Boot (sử dụng mysql-db khi chạy Docker)
SPRING_DATASOURCE_URL=jdbc:mysql://mysql-db:3306/hotel_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8

# -----------------------------------------------------------------------------
# 2. BACKEND SERVER & JWT CONFIGURATION
# -----------------------------------------------------------------------------
# Cổng expose ra ngoài Host (máy chủ) cho Backend
BACKEND_HOST_PORT=8080
# Khóa bí mật JWT tối thiểu 256 bits (32 bytes ngẫu nhiên) - THAY ĐỔI KHI DEPLOY
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Thời hạn Access Token: 1800000 ms (30 phút)
JWT_ACCESS_EXPIRATION_MS=1800000
# Thời hạn Refresh Token: 604800000 ms (7 ngày)
JWT_REFRESH_EXPIRATION_MS=604800000

# -----------------------------------------------------------------------------
# 3. CLOUDINARY CONFIGURATION (Lưu trữ ảnh buồng phòng)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -----------------------------------------------------------------------------
# 4. VNPAY SANDBOX CONFIGURATION (Thanh toán cọc online 50%)
# -----------------------------------------------------------------------------
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment-result

# -----------------------------------------------------------------------------
# 5. MAIL CONFIGURATION (JavaMailSender / SMTP)
# -----------------------------------------------------------------------------
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_email_app_password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# -----------------------------------------------------------------------------
# 6. FRONTEND CONFIGURATION (Vite React & Nginx)
# -----------------------------------------------------------------------------
# Cổng expose ra ngoài Host (máy chủ) cho Frontend
FRONTEND_HOST_PORT=80
VITE_API_BASE_URL=http://localhost:8080/api/v1
