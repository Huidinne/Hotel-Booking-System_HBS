{
  "info": {
    "_postman_id": "hbs-api-collection-v2",
    "name": "Hotel Booking System (HBS) - API Test Collection",
    "description": "Bộ kịch bản kiểm thử API chi tiết cho dự án Hotel Booking System (MVP), bao gồm Auth & Phân quyền, Tìm kiếm phòng, Đặt phòng & Chống trùng lịch (Overbooking), Hủy phòng và Vận hành Lễ tân.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "customer2Token",
      "value": "",
      "type": "string"
    },
    {
      "key": "receptionistToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "bookingCode",
      "value": "",
      "type": "string"
    },
    {
      "key": "roomTypeId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Authentication & RBAC",
      "item": [
        {
          "name": "1.1 Đăng ký tài khoản Customer mới",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman_customer@test.com\",\n  \"password\": \"Password@123\",\n  \"fullName\": \"Postman Tester\",\n  \"phone\": \"0987654321\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 or 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set(\"customerToken\", jsonData.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.2 Đăng nhập Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@gmail.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login Customer Success - 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.accessToken).to.not.be.empty;",
                  "    pm.collectionVariables.set(\"customerToken\", json.data.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.3 Đăng nhập sai mật khẩu (Negative Test)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@gmail.com\",\n  \"password\": \"WrongPass@999\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login Fail - 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.4 Đăng nhập Lễ tân (Receptionist)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"receptionist@hotel.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login Receptionist - 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set(\"receptionistToken\", json.data.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.5 RBAC: Customer gọi API Lễ tân (Bị chặn 403)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/receptionist/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "receptionist", "bookings"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Customer call Receptionist API -> 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "1.6 RBAC: Không truyền Token vào API bảo vệ (Bị chặn 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings/my-bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings", "my-bookings"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"No Token -> 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02. Room Search & Catalog",
      "item": [
        {
          "name": "2.1 Lấy toàn bộ danh mục Loại phòng (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/room-types",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "room-types"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Get Room Types - 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.length).to.be.above(0);",
                  "    pm.collectionVariables.set(\"roomTypeId\", json.data[0].roomTypeId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2.2 Tìm kiếm phòng trống hợp lệ theo ngày",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/room-types/search?checkIn=2026-11-15&checkOut=2026-11-18&guests=2&quantity=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "room-types", "search"],
              "query": [
                { "key": "checkIn", "value": "2026-11-15" },
                { "key": "checkOut", "value": "2026-11-18" },
                { "key": "guests", "value": "2" },
                { "key": "quantity", "value": "1" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Search Available Rooms - 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2.3 Tìm kiếm ngày không hợp lệ (checkOut <= checkIn) -> 400 Bad Request",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/room-types/search?checkIn=2026-11-18&checkOut=2026-11-15&guests=2&quantity=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "room-types", "search"],
              "query": [
                { "key": "checkIn", "value": "2026-11-18" },
                { "key": "checkOut", "value": "2026-11-15" },
                { "key": "guests", "value": "2" },
                { "key": "quantity", "value": "1" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Invalid date search -> 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03. Booking & Overbooking Prevention",
      "item": [
        {
          "name": "3.1 Khách hàng đặt phòng hợp lệ",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomTypeId\": {{roomTypeId}},\n  \"checkIn\": \"2026-12-01\",\n  \"checkOut\": \"2026-12-04\",\n  \"quantity\": 1,\n  \"guests\": 2,\n  \"paymentMethod\": \"CASH\",\n  \"note\": \"Kiểm thử Postman Collection\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Create Booking Success - 201 Created\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.bookingCode).to.not.be.empty;",
                  "    pm.expect(json.data.depositAmount).to.be.above(0);",
                  "    pm.collectionVariables.set(\"bookingCode\", json.data.bookingCode);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3.2 Đặt phòng quá năng lực / trùng ngày khi hết quota -> 409 Conflict",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomTypeId\": {{roomTypeId}},\n  \"checkIn\": \"2026-12-02\",\n  \"checkOut\": \"2026-12-05\",\n  \"quantity\": 99,\n  \"guests\": 2,\n  \"paymentMethod\": \"CASH\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Overbooking/Not enough rooms -> 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.message).to.include(\"Số phòng trống không đủ\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3.3 Xem chi tiết booking vừa tạo theo bookingCode",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings/{{bookingCode}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings", "{{bookingCode}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Get Booking Detail - 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.bookingCode).to.eql(pm.collectionVariables.get(\"bookingCode\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3.4 Khách hàng hủy đặt phòng (Chính chủ)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Đổi lịch trình cá nhân\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings/{{bookingCode}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bookings", "{{bookingCode}}", "cancel"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Cancel Booking Success - 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.bookingStatus).to.eql(\"CANCELLED\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04. Receptionist Operations",
      "item": [
        {
          "name": "4.1 Lễ tân xem danh sách toàn bộ Bookings có lọc",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{receptionistToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/receptionist/bookings?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "receptionist", "bookings"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Receptionist List Bookings - 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
