          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400 Bad Request\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test(\"Thông báo lỗi vượt quá độ dài ký tự\", function () {",
              "    var res = pm.response.json();",
              "    pm.expect(res.status).to.eql(400);",
              "    pm.expect(res.message).to.include(\"không được vượt quá 1000 ký tự\");",
              "});"
            ]
          }
