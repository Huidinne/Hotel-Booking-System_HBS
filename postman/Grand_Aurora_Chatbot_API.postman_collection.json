              "});",
              "pm.test(\"Thông báo lỗi rõ ràng theo Contract\", function () {",
              "    var res = pm.response.json();",
              "    pm.expect(res.status).to.eql(400);",
              "    pm.expect(res.message).to.include(\"Nội dung tin nhắn không được để trống\");",
              "});"
            ]
          }
        }
