<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Grand Aurora Hotel - Concurrency &amp; Overbooking Prevention Test Plan" enabled="true">
      <stringProp name="TestPlan.comments">Task [SP2-1105-TRUNG]: Kiểm thử tải tranh chấp đặt phòng đồng thời (10 users tranh chấp 1 suất phòng duy nhất)</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="PROTOCOL" elementType="Argument">
            <stringProp name="Argument.name">PROTOCOL</stringProp>
            <stringProp name="Argument.value">${__P(protocol,http)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">${__P(host,localhost)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PORT" elementType="Argument">
            <stringProp name="Argument.name">PORT</stringProp>
            <stringProp name="Argument.value">${__P(port,8080)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="BASE_PATH" elementType="Argument">
            <stringProp name="Argument.name">BASE_PATH</stringProp>
            <stringProp name="Argument.value">/api/v1</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ROOM_TYPE_ID" elementType="Argument">
            <stringProp name="Argument.name">ROOM_TYPE_ID</stringProp>
            <stringProp name="Argument.value">${__P(roomTypeId,99)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CHECK_IN_DATE" elementType="Argument">
            <stringProp name="Argument.name">CHECK_IN_DATE</stringProp>
            <stringProp name="Argument.value">${__P(checkIn,2026-12-01)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CHECK_OUT_DATE" elementType="Argument">
            <stringProp name="Argument.name">CHECK_OUT_DATE</stringProp>
            <stringProp name="Argument.value">${__P(checkOut,2026-12-03)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="QUANTITY" elementType="Argument">
            <stringProp name="Argument.name">QUANTITY</stringProp>
            <stringProp name="Argument.value">1</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="GUESTS" elementType="Argument">
            <stringProp name="Argument.name">GUESTS</stringProp>
            <stringProp name="Argument.value">2</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TEST_USERS_CSV" elementType="Argument">
            <stringProp name="Argument.name">TEST_USERS_CSV</stringProp>
            <stringProp name="Argument.value">${__P(csvPath,tests/fixtures/test_users.csv)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <!-- Cấu hình HTTP Request Defaults (Linh hoạt chuyển đổi môi trường Local / VPS) -->
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults" enabled="true">
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
          <collectionProp name="Arguments.arguments"/>
        </elementProp>
        <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
        <stringProp name="HTTPSampler.port">${PORT}</stringProp>
        <stringProp name="HTTPSampler.protocol">${PROTOCOL}</stringProp>
        <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
        <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
        <stringProp name="HTTPSampler.response_timeout">10000</stringProp>
      </ConfigTestElement>
      <hashTree/>

      <!-- Global HTTP Header Manager -->
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Global HTTP Header Manager" enabled="true">
        <collectionProp name="HeaderManager.headers">
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Content-Type</stringProp>
            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Accept</stringProp>
            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
        </collectionProp>
      </HeaderManager>
      <hashTree/>

      <!-- ================================================================= -->
      <!-- THREAD GROUP: KIỂM THỬ TRANH CHẤP ĐỒNG THỜI (10 CONCURRENT USERS)  -->
      <!-- ================================================================= -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Luồng Kiểm Thử Concurrency - 10 Users Tranh Chấp 1 Phòng" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">10</stringProp>
        <stringProp name="ThreadGroup.ramp_time">0</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
      </ThreadGroup>
      <hashTree>
        <!-- CSV Data Set Config nạp 10 tài khoản test độc lập -->
        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV Data Set - 10 Test Accounts" enabled="true">
          <stringProp name="delimiter">,</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="filename">${TEST_USERS_CSV}</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">true</boolProp>
          <stringProp name="shareMode">shareMode.all</stringProp>
          <boolProp name="stopThread">false</boolProp>
          <stringProp name="variableNames">email,password</stringProp>
        </CSVDataSet>
        <hashTree/>

        <!-- Bước 1: Đăng nhập lấy JWT Token cho từng thread -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="1. Đăng nhập - Auth Login (${email})" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&#xd;
  &quot;email&quot;: &quot;${email}&quot;,&#xd;
  &quot;password&quot;: &quot;${password}&quot;&#xd;
}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.path">${BASE_PATH}/auth/login</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <!-- Assertion xác thực đăng nhập thành công 200 OK -->
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert Login 200 OK" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
          <!-- JSON Extractor lấy JWT Access Token -->
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="JSON Extractor - Access Token" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">CONCURRENT_TOKEN</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.data.accessToken</stringProp>
            <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">TOKEN_NOT_FOUND</stringProp>
          </JSONPostProcessor>
          <hashTree/>
        </hashTree>

        <!-- Điểm hội tụ (Rendezvous Point): Synchronizing Timer giữ chân cả 10 thread rồi xả cùng 1 thời điểm -->
        <SyncTimer guiclass="TestBeanGUI" testclass="SyncTimer" testname="Synchronizing Timer (Rendezvous 10 Threads Spike)" enabled="true">
          <intProp name="groupSize">10</intProp>
          <longProp name="timeoutInMs">10000</longProp>
        </SyncTimer>
        <hashTree/>

        <!-- Bước 2: Bắn đồng thời 10 request đặt phòng cạnh tranh 1 suất phòng duy nhất -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="2. Đặt phòng đồng thời - Create Booking (Contention on Room 99)" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&#xd;
  &quot;roomTypeId&quot;: ${ROOM_TYPE_ID},&#xd;
  &quot;quantity&quot;: ${QUANTITY},&#xd;
  &quot;guests&quot;: ${GUESTS},&#xd;
  &quot;checkIn&quot;: &quot;${CHECK_IN_DATE}&quot;,&#xd;
  &quot;checkOut&quot;: &quot;${CHECK_OUT_DATE}&quot;,&#xd;
  &quot;paymentMethod&quot;: &quot;CASH&quot;,&#xd;
  &quot;note&quot;: &quot;JMeter Overbooking Prevention Test - User: ${email}&quot;&#xd;
}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.path">${BASE_PATH}/bookings</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <!-- Gắn Header Authorization kèm JWT Token vừa đăng nhập -->
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Bearer Token Auth Header" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">Bearer ${CONCURRENT_TOKEN}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>

          <!-- Phân loại lỗi và Assertion nâng cao bằng JSR223 Groovy Assertion -->
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion - Phân loại nghiệp vụ 201 vs 409 vs Lỗi Auth/Hạ tầng" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">
def responseCode = prev.getResponseCode()
def responseBody = prev.getResponseDataAsString()
def threadName = ctx.getThread().getThreadName()
def threadNum = ctx.getThreadNum()

// 1. Phân loại THÀNH CÔNG (HTTP 201 Created) - Chỉ đúng 1 user được phép thành công
if (responseCode == &quot;201&quot;) {
    if (responseBody.contains(&quot;\&quot;bookingCode\&quot;&quot;) &amp;&amp; responseBody.contains(&quot;\&quot;success\&quot;:true&quot;)) {
        AssertionResult.setFailure(false)
        prev.setSuccessful(true)
        log.info(&quot;[CONCURRENCY WINNER] Thread &quot; + threadNum + &quot; (&quot; + vars.get(&quot;email&quot;) + &quot;) đặt phòng THÀNH CÔNG! BookingCode phản hồi hợp lệ.&quot;)
    } else {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&quot;Lỗi nghiệp vụ: HTTP 201 trả về nhưng thiếu bookingCode hoặc success:true trong payload: &quot; + responseBody)
    }
}
// 2. Phân loại XUNG ĐỘT NGHIỆP VỤ HẾT PHÒNG (HTTP 409 Conflict) - 9 users thất bại an toàn
else if (responseCode == &quot;409&quot;) {
    if (responseBody.contains(&quot;không đủ&quot;) || responseBody.contains(&quot;Conflict&quot;) || responseBody.contains(&quot;409&quot;)) {
        AssertionResult.setFailure(false)
        // Đánh dấu sample hợp lệ theo kịch bản nghiệp vụ mong đợi (Expected Business Rejection)
        prev.setSuccessful(true)
        log.info(&quot;[EXPECTED BUSINESS REJECTION] Thread &quot; + threadNum + &quot; (&quot; + vars.get(&quot;email&quot;) + &quot;) bị từ chối 409 hợp lệ do hết phòng (Pessimistic Lock hoạt động hoàn hảo).&quot;)
    } else {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage(&quot;Lỗi hợp đồng API: HTTP 409 trả về nhưng message không chứa thông điệp hết phòng mong đợi: &quot; + responseBody)
    }
}
// 3. Phân biệt LỖI XÁC THỰC (HTTP 401 Unauthorized / HTTP 403 Forbidden)
else if (responseCode == &quot;401&quot; || responseCode == &quot;403&quot;) {
    AssertionResult.setFailure(true)
    prev.setSuccessful(false)
    AssertionResult.setFailureMessage(&quot;[NGHIÊM TRỌNG - LỖI XÁC THỰC] HTTP &quot; + responseCode + &quot; - Token không hợp lệ hoặc không có quyền truy cập! Response: &quot; + responseBody)
}
// 4. Phân biệt LỖI HẠ TẦNG / HỆ THỐNG (HTTP 500 / 502 / 504 / Connection Timeout)
else if (responseCode.startsWith(&quot;5&quot;) || responseCode == &quot;000&quot;) {
    AssertionResult.setFailure(true)
    prev.setSuccessful(false)
    AssertionResult.setFailureMessage(&quot;[NGHIÊM TRỌNG - LỖI HẠ TẦNG/DEADLOCK] HTTP &quot; + responseCode + &quot; - Lỗi máy chủ hoặc nghẽn cơ sở dữ liệu! Response: &quot; + responseBody)
}
// 5. Các mã HTTP khác không mong muốn
else {
    AssertionResult.setFailure(true)
    prev.setSuccessful(false)
    AssertionResult.setFailureMessage(&quot;[MÃ TRẢ VỀ BẤT THƯỜNG] HTTP &quot; + responseCode + &quot; không nằm trong hợp đồng kiểm thử: &quot; + responseBody)
}
            </stringProp>
          </JSR223Assertion>
          <hashTree/>

          <!-- Response Assertion cơ bản tương thích JMeter chuẩn -->
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Response Code Assertion (201 or 409)" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49587">201</stringProp>
              <stringProp name="51517">409</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">true</boolProp>
            <intProp name="Assertion.test_type">40</intProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>
      </hashTree>

      <!-- ================================================================= -->
      <!-- LISTENERS (BÁO CÁO & THEO DÕI KẾT QUẢ KIỂM THỬ)                   -->
      <!-- ================================================================= -->
      <ResultCollector guiclass="ViewResultsFullVisualizer" testclass="ResultCollector" testname="View Results Tree" enabled="true">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <objProp>
          <name>saveConfig</name>
          <value class="SampleSaveConfiguration">
            <time>true</time>
            <latency>true</latency>
            <timestamp>true</timestamp>
            <success>true</success>
            <label>true</label>
            <code>true</code>
            <message>true</message>
            <threadName>true</threadName>
            <dataType>true</dataType>
            <encoding>false</encoding>
            <assertions>true</assertions>
            <subresults>true</subresults>
            <responseData>false</responseData>
            <samplerData>false</samplerData>
            <xml>false</xml>
            <fieldNames>true</fieldNames>
            <responseHeaders>false</responseHeaders>
            <requestHeaders>false</requestHeaders>
            <responseDataOnError>false</responseDataOnError>
            <saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage>
            <assertionsResultsToSave>0</assertionsResultsToSave>
            <bytes>true</bytes>
            <sentBytes>true</sentBytes>
            <url>true</url>
            <threadCounts>true</threadCounts>
            <idleTime>true</idleTime>
            <connectTime>true</connectTime>
          </value>
        </objProp>
        <stringProp name="filename"></stringProp>
      </ResultCollector>
      <hashTree/>

      <ResultCollector guiclass="SummaryReport" testclass="ResultCollector" testname="Summary Report" enabled="true">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <objProp>
          <name>saveConfig</name>
          <value class="SampleSaveConfiguration">
            <time>true</time>
            <latency>true</latency>
            <timestamp>true</timestamp>
            <success>true</success>
            <label>true</label>
            <code>true</code>
            <message>true</message>
            <threadName>true</threadName>
            <dataType>true</dataType>
            <encoding>false</encoding>
            <assertions>true</assertions>
            <subresults>true</subresults>
            <responseData>false</responseData>
            <samplerData>false</samplerData>
            <xml>false</xml>
            <fieldNames>true</fieldNames>
            <responseHeaders>false</responseHeaders>
            <requestHeaders>false</requestHeaders>
            <responseDataOnError>false</responseDataOnError>
            <saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage>
            <assertionsResultsToSave>0</assertionsResultsToSave>
            <bytes>true</bytes>
            <sentBytes>true</sentBytes>
            <url>true</url>
            <threadCounts>true</threadCounts>
            <idleTime>true</idleTime>
            <connectTime>true</connectTime>
          </value>
        </objProp>
        <stringProp name="filename"></stringProp>
      </ResultCollector>
      <hashTree/>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
